---
import usage from "../data/kimi-usage.json";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Shanghai",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false
});

const accounts = usage.accounts.map((account) => ({
  name: account.name,
  quotas: [
    {
      label: "5h",
      remainingPercent: account.fiveHour.remainingPercent,
      resetsAt: new Date(account.fiveHour.resetsAt),
      color: "#5b7cfa"
    },
    {
      label: "Weekly",
      remainingPercent: account.weekly.remainingPercent,
      resetsAt: new Date(account.weekly.resetsAt),
      color: "#8a5cf6"
    }
  ]
}));

const capturedAt = new Date(usage.capturedAt);
---

<section class="kimi-usage-row" aria-label="Kimi account quotas">
  {accounts.map((account) => (
    <article
      class="kimi-usage"
      aria-labelledby={`kimi-usage-${account.name}`}
      data-quota-card
      data-provider="kimi"
      data-account={account.name}
    >
      <div class="usage-header">
        <span class="usage-title" id={`kimi-usage-${account.name}`}>{account.name}</span>
        <span class="snapshot-badge" data-quota-badge>snapshot</span>
      </div>

      <div class="quota-rings">
        {account.quotas.map((quota) => {
          const remainingPercent = Math.max(0, Math.min(100, quota.remainingPercent));
          const resetLabel = dateFormatter.format(quota.resetsAt);
          const description = `${account.name} ${quota.label} quota: ${remainingPercent}% remaining; resets ${resetLabel}`;

          return (
            <div
              class="quota-item"
              role="img"
              aria-label={description}
              title={description}
              data-window={quota.label === "5h" ? "fiveHour" : "weekly"}
            >
              <div class="quota-ring" style={`--ring-color: ${quota.color}`}>
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <circle class="ring-track" cx="32" cy="32" r="26" pathLength="100"></circle>
                  <circle
                    class="ring-value"
                    cx="32"
                    cy="32"
                    r="26"
                    pathLength="100"
                    stroke-dasharray={`${remainingPercent} ${100 - remainingPercent}`}
                    data-quota-ring
                  ></circle>
                </svg>
                <strong data-quota-percent>{remainingPercent}%</strong>
              </div>
              <span class="quota-label">{quota.label} left</span>
              <time datetime={quota.resetsAt.toISOString()} data-quota-reset>Reset {resetLabel}</time>
            </div>
          );
        })}
      </div>

      <p class="updated-at">
        Updated <time datetime={capturedAt.toISOString()} data-quota-updated>{dateFormatter.format(capturedAt)}</time>
      </p>
    </article>
  ))}
</section>

<style>
  .kimi-usage-row {
    display: flex;
    align-items: stretch;
    gap: 0.8rem;
    margin-top: 0.8rem;
  }

  .kimi-usage {
    flex: 0 0 13.25rem;
    width: 13.25rem;
    max-width: 100%;
    padding: 1rem 0.9rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
  }

  .usage-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .usage-title {
    font-weight: 600;
  }

  .snapshot-badge {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
  }

  .quota-rings {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .quota-item {
    min-width: 0;
    text-align: center;
  }

  .quota-ring {
    position: relative;
    width: 4.6rem;
    height: 4.6rem;
    margin: 0 auto 0.35rem;
  }

  .quota-ring svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .quota-ring circle {
    fill: none;
    stroke-width: 7;
  }

  .ring-track {
    stroke: #eeeeec;
  }

  .ring-value {
    stroke: var(--ring-color);
    stroke-linecap: round;
  }

  .quota-ring strong {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.96rem;
    line-height: 1;
  }

  .quota-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .quota-item time,
  .updated-at {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .quota-item time {
    display: block;
    margin-top: 0.08rem;
    line-height: 1.35;
  }

  .updated-at {
    margin: 0.7rem 0 0;
    padding-top: 0.55rem;
    border-top: 1px solid var(--line);
    text-align: right;
  }

  @media (max-width: 560px) {
    .kimi-usage-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
